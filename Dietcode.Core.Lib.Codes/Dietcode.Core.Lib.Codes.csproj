<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>	

		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<Owner>Dietcode</Owner>
		<Authors>Humberto Almeida</Authors>
		<Description>Dietcode Core Lib Codes - Bar and QR Codes Generator</Description>
		<Copyright>Dietcode Web</Copyright>
		<PackageProjectUrl>http://www.dietcode.com.br</PackageProjectUrl>
		<Title>Dietcode Core Lib Codes</Title>

		<Version>10.0.0</Version>
		<AssemblyVersion>10.0.0</AssemblyVersion>
		<FileVersion>10.0.0.0</FileVersion>

		<PackageOutputPath>C:\Desenvolvimento\Nuget\Dietcode</PackageOutputPath>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageIcon>dietcode128.png</PackageIcon>
		<NeutralLanguage>pt-BR</NeutralLanguage>

		<!-- O motor de QR (portado do QRCoder, MIT) usa Span<T>/Memory<T> em código
         atrás de #if HAS_SPAN; net10.0 sempre suporta, mas o símbolo não é
         definido automaticamente pelo SDK (é específico do QRCoder). -->
		<DefineConstants>$(DefineConstants);HAS_SPAN</DefineConstants>
	</PropertyGroup>

	<ItemGroup>
		<!-- O QRCoder upstream declara esses usings globais via Directory.Build.props;
         replicando aqui já que este projeto não compartilha esse arquivo. -->
		<Using Include="System.Collections.BitArray" Alias="BitArray" />
		<Using Include="System.Globalization" />
		<Using Include="System.Text" />
		<Using Include="System.Text.RegularExpressions" />
	</ItemGroup>
	<ItemGroup>
		<None Include="C:\Users\humbe\OneDrive\Desenvolvimento\DevDietcode\DietTools\Icon\dietcode128.png" Pack="true" PackagePath="\" />
	</ItemGroup>
	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="" />
	</ItemGroup>

</Project>
